# Credenciais do Azure AD App Registration usado para autenticar
# na Power BI REST API (fluxo client credentials / service principal).
# Nunca commite um arquivo `.env` real — apenas este exemplo.
POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_SECRET=troque-por-um-segredo-real

# Caminho do banco SQLite gerado pelo ETL (padrão já funciona local).
BI_TOOLKIT_DB_PATH=data/bi_toolkit.db
